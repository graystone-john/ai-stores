#!/usr/bin/env bash
set -euo pipefail

VERSION="3.12.15"
FILENAME="Python-${VERSION}.tar.xz"
SHA256="c2c4321961fab0fb999d66e0cecf521c2ab3994c7992873ea99e306c1094fd5a"

URL="https://www.python.org/ftp/python/${VERSION}/${FILENAME}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AI_STORES="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"

DEST_DIR="$AI_STORES/vault/python/cpython/${VERSION}"
DEST="$DEST_DIR/$FILENAME"
TEMP="$DEST.tmp"

for command in curl sha256sum; do
    command -v "$command" >/dev/null || {
        echo "ERROR: required command missing: $command" >&2
        exit 1
    }
done

mkdir -p "$DEST_DIR"

if [[ -f "$DEST" ]]; then
    ACTUAL="$(sha256sum "$DEST" | awk '{print $1}')"

    if [[ "$ACTUAL" == "$SHA256" ]]; then
        echo "AI Stores: already valid: $FILENAME"
        exit 0
    fi

    echo "ERROR: existing artifact has unexpected SHA-256" >&2
    echo "expected: $SHA256" >&2
    echo "actual:   $ACTUAL" >&2
    exit 1
fi

rm -f "$TEMP"

echo "=== ACQUIRING OFFICIAL PYTHON ==="
echo "Version: $VERSION"
echo "Source:  $URL"

curl \
  --fail \
  --location \
  --retry 5 \
  --retry-delay 5 \
  "$URL" \
  --output "$TEMP"

ACTUAL="$(sha256sum "$TEMP" | awk '{print $1}')"

if [[ "$ACTUAL" != "$SHA256" ]]; then
    echo "ERROR: SHA-256 mismatch" >&2
    echo "expected: $SHA256" >&2
    echo "actual:   $ACTUAL" >&2
    rm -f "$TEMP"
    exit 1
fi

mv "$TEMP" "$DEST"

echo
echo "=== ACQUISITION COMPLETE ==="
echo "SHA256: $SHA256"
echo "Saved:"
echo "  $DEST"
