#!/usr/bin/env bash
set -euo pipefail

VERSION="3.12.14"
RELEASE="20260825"
FILENAME="cpython-${VERSION}+${RELEASE}-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz"
SHA256="7ce4a71285d913955a76053cc7605ea96da8ecada54dba9cf395245961816421"

URL="https://github.com/astral-sh/python-build-standalone/releases/download/${RELEASE}/${FILENAME}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AI_STORES="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"

DEST_DIR="$AI_STORES/vault/python/runtimes/astral/python-build-standalone/releases/${RELEASE}"
DEST="$DEST_DIR/$FILENAME"
TEMP="$DEST.tmp"

for command in curl sha256sum tar; do
    command -v "$command" >/dev/null || {
        echo "ERROR: required command missing: $command" >&2
        exit 1
    }
done

mkdir -p "$DEST_DIR"

if [[ -f "$DEST" ]]; then
    ACTUAL="$(sha256sum "$DEST" | awk '{print $1}')"

    if [[ "$ACTUAL" == "$SHA256" ]]; then
        echo "AI Stores: already valid: $FILENAME"
        exit 0
    fi

    echo "ERROR: existing artifact has unexpected SHA-256" >&2
    echo "expected: $SHA256" >&2
    echo "actual:   $ACTUAL" >&2
    exit 1
fi

rm -f "$TEMP"

echo "=== ACQUIRING PREBUILT CPYTHON RUNTIME ==="
echo "Python:  $VERSION"
echo "Release: $RELEASE"
echo "Source:  $URL"

curl \
  --fail \
  --location \
  --retry 5 \
  --retry-delay 5 \
  "$URL" \
  --output "$TEMP"

ACTUAL="$(sha256sum "$TEMP" | awk '{print $1}')"

if [[ "$ACTUAL" != "$SHA256" ]]; then
    echo "ERROR: SHA-256 mismatch" >&2
    echo "expected: $SHA256" >&2
    echo "actual:   $ACTUAL" >&2
    rm -f "$TEMP"
    exit 1
fi

echo
echo "=== VERIFY ARCHIVE ==="
tar -tzf "$TEMP" >/dev/null

mv "$TEMP" "$DEST"

echo
echo "=== ACQUISITION COMPLETE ==="
sha256sum "$DEST"
echo "Saved:"
echo "  $DEST"
