#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: $0 <snapshot> [output-directory]" >&2
    echo "Example: $0 2026.09.28" >&2
    exit 2
fi

SNAPSHOT="$1"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_LIST="$SCRIPT_DIR/packages.txt"
OUT="${2:-/run/archiso/httpspace/graystone-arch-pacman}"

NATIVE_ARCH="x86_64"
REPOSITORIES=(core extra)

die() {
    echo "ERROR: $*" >&2
    exit 1
}

[[ "$(uname -m)" == "$NATIVE_ARCH" ]] ||
    die "Capture requires $NATIVE_ARCH."

[[ -f /etc/arch-release ]] ||
    die "Capture requires Arch Linux."

command -v pacman >/dev/null ||
    die "pacman is required."

[[ -s "$PACKAGE_LIST" ]] ||
    die "Missing package manifest: $PACKAGE_LIST"

mapfile -t PACKAGES < <(
    grep -Ev '^[[:space:]]*(#|$)' "$PACKAGE_LIST"
)

[[ ${#PACKAGES[@]} -gt 0 ]] ||
    die "Package manifest is empty."

echo "=== Graystone Arch pacman sparse mirror capture ==="
echo "Snapshot:     $SNAPSHOT"
echo "Architecture: $NATIVE_ARCH"
echo "Output:       $OUT"
echo
echo "Requested packages:"
printf '  %s\n' "${PACKAGES[@]}"
echo

rm -rf "$OUT"

WORK="$(mktemp -d /tmp/graystone-arch-pacman.XXXXXX)"
trap 'rm -rf "$WORK"' EXIT

CACHE="$WORK/cache"

mkdir -p \
    "$WORK/root" \
    "$WORK/db" \
    "$CACHE" \
    "$OUT/manifest"

#
# Arch pacman downloads as DownloadUser=alpm by default.
# Allow that unprivileged account to traverse the temporary workspace
# and write only to pacman's database and package-download locations.
#
if getent passwd alpm >/dev/null 2>&1; then
    chmod 0755 "$WORK"
    chown -R alpm:alpm "$WORK/db" "$CACHE"
fi

for repo in "${REPOSITORIES[@]}"; do
    mkdir -p "$OUT/$repo/os/$NATIVE_ARCH"
done

cp "$PACKAGE_LIST" \
    "$OUT/manifest/requested-packages.txt"

echo "=== RESOLVING EMPTY TARGET ==="

pacman \
    --root "$WORK/root" \
    --dbpath "$WORK/db" \
    --cachedir "$CACHE" \
    --noconfirm \
    --needed \
    --quiet \
    -Syw \
    "${PACKAGES[@]}"

echo
echo "=== PRESERVING OFFICIAL REPOSITORY DATABASES ==="

for repo in "${REPOSITORIES[@]}"; do
    db="$WORK/db/sync/$repo.db"

    [[ -f "$db" ]] ||
        die "Official repository database missing: $repo.db"

    cp -a \
        "$db" \
        "$OUT/$repo/os/$NATIVE_ARCH/$repo.db"
done

echo
echo "=== INDEXING OFFICIAL REPOSITORY DATABASES ==="

for repo in "${REPOSITORIES[@]}"; do
    db="$WORK/db/sync/$repo.db"
    names="$WORK/$repo-package-names.txt"

    tar -xOf "$db" --wildcards '*/desc' 2>/dev/null |
        awk '
            $0 == "%NAME%" {
                getline
                print
            }
        ' |
        sort -u > "$names"

    [[ -s "$names" ]] ||
        die "Could not index package names from $repo.db"
done

echo
echo "=== RESOLVED DEPENDENCY CLOSURE ==="

{
    printf 'repository\tname\tversion\tarchitecture\tfilename\n'

    for pkg in "$CACHE"/*.pkg.tar.zst; do
        query="$(pacman --config /dev/null -Qp "$pkg")"
        name="${query%% *}"
        version="${query#* }"

        arch="$(
            pacman --config /dev/null -Qip "$pkg" |
            awk -F ': ' '/^Architecture/ {print $2; exit}'
        )"

        repo="unknown"

        if grep -Fxq "$name" "$WORK/core-package-names.txt"; then
            repo="core"
        elif grep -Fxq "$name" "$WORK/extra-package-names.txt"; then
            repo="extra"
        fi

        printf '%s\t%s\t%s\t%s\t%s\n' \
            "$repo" \
            "$name" \
            "$version" \
            "$arch" \
            "$(basename "$pkg")"
    done
} > "$OUT/manifest/resolved-packages.unsorted.tsv"

{
    head -1 "$OUT/manifest/resolved-packages.unsorted.tsv"

    tail -n +2 "$OUT/manifest/resolved-packages.unsorted.tsv" |
        sort -t $'\t' -k2,2
} > "$OUT/manifest/resolved-packages.tsv"

rm "$OUT/manifest/resolved-packages.unsorted.tsv"

RESOLVED_COUNT="$(
    tail -n +2 "$OUT/manifest/resolved-packages.tsv" |
    wc -l
)"

[[ "$RESOLVED_COUNT" -gt 0 ]] ||
    die "No packages resolved."

if awk -F '\t' \
    'NR > 1 && $1 == "unknown" { found=1 } END { exit !found }' \
    "$OUT/manifest/resolved-packages.tsv"
then
    echo "Packages with unknown repository:" >&2
    awk -F '\t' \
        'NR > 1 && $1 == "unknown"' \
        "$OUT/manifest/resolved-packages.tsv" >&2
    die "Repository provenance is incomplete."
fi

echo
echo "=== POPULATING SPARSE MIRROR ==="

while IFS=$'\t' read -r repo name version arch filename; do
    [[ "$repo" == "repository" ]] && continue

    src="$CACHE/$filename"
    sig="$src.sig"
    dest="$OUT/$repo/os/$NATIVE_ARCH"

    [[ -f "$src" ]] ||
        die "Captured package missing: $filename"

    [[ -f "$sig" ]] ||
        die "Captured signature missing: $filename.sig"

    cp -a "$src" "$dest/$filename"
    cp -a "$sig" "$dest/$filename.sig"

done < "$OUT/manifest/resolved-packages.tsv"

echo
echo "=== PACKAGE INVENTORY ==="

find "$OUT/core/os/$NATIVE_ARCH" \
     "$OUT/extra/os/$NATIVE_ARCH" \
    -maxdepth 1 \
    -type f \
    -name '*.pkg.tar.zst' \
    -printf '%P\n' |
    sort > "$OUT/manifest/package-files.txt"

find "$OUT/core/os/$NATIVE_ARCH" \
     "$OUT/extra/os/$NATIVE_ARCH" \
    -maxdepth 1 \
    -type f \
    -name '*.pkg.tar.zst.sig' \
    -printf '%P\n' |
    sort > "$OUT/manifest/signature-files.txt"

PACKAGE_COUNT="$(
    find "$OUT/core/os/$NATIVE_ARCH" \
         "$OUT/extra/os/$NATIVE_ARCH" \
        -maxdepth 1 \
        -type f \
        -name '*.pkg.tar.zst' |
        wc -l
)"

SIGNATURE_COUNT="$(
    find "$OUT/core/os/$NATIVE_ARCH" \
         "$OUT/extra/os/$NATIVE_ARCH" \
        -maxdepth 1 \
        -type f \
        -name '*.pkg.tar.zst.sig' |
        wc -l
)"

[[ "$PACKAGE_COUNT" -eq "$RESOLVED_COUNT" ]] ||
    die "Package count differs from resolved closure."

[[ "$PACKAGE_COUNT" -eq "$SIGNATURE_COUNT" ]] ||
    die "Package/signature count mismatch: $PACKAGE_COUNT/$SIGNATURE_COUNT"

cat > "$OUT/manifest/capture.txt" <<META
distribution=arch
snapshot=$SNAPSHOT
native_architecture=$NATIVE_ARCH
requested_package_count=${#PACKAGES[@]}
resolved_package_count=$RESOLVED_COUNT
package_count=$PACKAGE_COUNT
signature_count=$SIGNATURE_COUNT
repositories=core extra
repository_layout=\$repo/os/\$arch
repository_databases=official
mirror_scope=sparse
META

echo
echo "=== CHECKSUMS ==="

(
    cd "$OUT"

    find core extra manifest \
        -type f \
        ! -path 'manifest/SHA256SUMS' \
        -print0 |
        sort -z |
        xargs -0 sha256sum > manifest/SHA256SUMS
)

echo
echo "=== VERIFY CHECKSUMS ==="

(
    cd "$OUT"
    sha256sum -c manifest/SHA256SUMS --quiet
)

echo
echo "=== CAPTURE COMPLETE ==="
echo "Packages:          $PACKAGE_COUNT"
echo "Signatures:        $SIGNATURE_COUNT"
echo "Resolved packages: $RESOLVED_COUNT"

echo
echo "Repository closure:"
awk -F '\t' '
    NR > 1 { count[$1]++ }
    END {
        for (repo in count)
            print "  " repo ": " count[repo]
    }
' "$OUT/manifest/resolved-packages.tsv" |
sort

echo
echo "Repository sizes:"
for repo in "${REPOSITORIES[@]}"; do
    printf "  %-6s " "$repo:"
    du -sh "$OUT/$repo/os/$NATIVE_ARCH" |
        awk '{print $1}'
done

echo
echo "Output:"
echo "  $OUT"
