#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODULE_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
STORE_ROOT="$(cd "${SCRIPT_DIR}/../../../../../../../.." && pwd)"

MANIFEST="${MODULE_ROOT}/amd64-closure.tsv"
APT_ROOT="${STORE_ROOT}/vault/linux/ubuntu/apt"
POOL="${APT_ROOT}/pool/main"

SNAPSHOT="20260829T030000Z"

for cmd in apt-get apt-cache dpkg-deb find; do
    command -v "$cmd" >/dev/null || {
        echo "ERROR: required command missing: $cmd" >&2
        exit 1
    }
done

mkdir -p "$POOL"

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

mkdir -p \
  "$WORK/etc/apt/sources.list.d" \
  "$WORK/state/lists/partial" \
  "$WORK/cache/archives/partial" \
  "$WORK/downloads"

cat > "$WORK/etc/apt/sources.list" <<'SOURCES'
deb [arch=amd64 signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] http://archive.ubuntu.com/ubuntu noble main universe restricted multiverse
deb [arch=amd64 signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] http://archive.ubuntu.com/ubuntu noble-updates main universe restricted multiverse
deb [arch=amd64 signed-by=/usr/share/keyrings/ubuntu-archive-keyring.gpg] http://security.ubuntu.com/ubuntu noble-security main universe restricted multiverse
SOURCES

APT_OPTS=(
  -o "Dir::Etc::sourcelist=$WORK/etc/apt/sources.list"
  -o "Dir::Etc::sourceparts=$WORK/etc/apt/sources.list.d"
  -o "Dir::State=$WORK/state"
  -o "Dir::State::lists=$WORK/state/lists"
  -o "Dir::Cache=$WORK/cache"
  -o "Dir::Cache::archives=$WORK/cache/archives"
  -o "APT::Architecture=amd64"
  -o "APT::Architectures::=amd64"
)

declare -A POOL_INDEX=()
pool_index_count=0

index_deb()
{
    local deb="$1"
    local pkg ver arch key

    pkg="$(dpkg-deb -f "$deb" Package)"
    ver="$(dpkg-deb -f "$deb" Version)"
    arch="$(dpkg-deb -f "$deb" Architecture)"

    [[ "$arch" == "amd64" || "$arch" == "all" ]] || return 0

    key="${pkg}|${ver}|${arch}"

    if [[ -z "${POOL_INDEX[$key]+x}" ]]; then
        POOL_INDEX["$key"]=1
        pool_index_count=$((pool_index_count + 1))
    fi
}

echo "AI Stores: indexing shared APT pool"

while IFS= read -r -d '' deb; do
    index_deb "$deb"
done < <(find "$POOL" -type f -name '*.deb' -print0)

echo "AI Stores: indexed ${pool_index_count} shared APT artifacts"

present()
{
    local wanted_pkg="$1"
    local wanted_ver="$2"

    [[ -n "${POOL_INDEX["${wanted_pkg}|${wanted_ver}|amd64"]+x}" ]] ||
    [[ -n "${POOL_INDEX["${wanted_pkg}|${wanted_ver}|all"]+x}" ]]
}

echo "AI Stores: refreshing Ubuntu Noble amd64 snapshot indexes"

apt-get \
  "${APT_OPTS[@]}" \
  --snapshot "$SNAPSHOT" \
  update

count=0

while IFS=$'\t' read -r pkg ver; do
    [[ -n "$pkg" ]] || continue

    if present "$pkg" "$ver"; then
        echo "PRESENT: ${pkg}=${ver}"
        continue
    fi

    echo "ACQUIRE: ${pkg}=${ver}"

    rm -f "$WORK/downloads"/*.deb

    (
        cd "$WORK/downloads"

        apt-get \
          "${APT_OPTS[@]}" \
          --snapshot "$SNAPSHOT" \
          download "${pkg}:amd64=${ver}" \
        || \
        apt-get \
          "${APT_OPTS[@]}" \
          --snapshot "$SNAPSHOT" \
          download "${pkg}=${ver}"
    )

    mapfile -d '' debs < <(
        find "$WORK/downloads" \
          -maxdepth 1 \
          -type f \
          -name '*.deb' \
          -print0
    )

    if [[ "${#debs[@]}" -ne 1 ]]; then
        echo "ERROR: expected exactly one downloaded package for ${pkg}=${ver}" >&2
        exit 1
    fi

    deb="${debs[0]}"

    actual_pkg="$(dpkg-deb -f "$deb" Package)"
    actual_ver="$(dpkg-deb -f "$deb" Version)"
    actual_arch="$(dpkg-deb -f "$deb" Architecture)"

    if [[ "$actual_pkg" != "$pkg" ]]; then
        echo "ERROR: package mismatch: wanted $pkg, got $actual_pkg" >&2
        exit 1
    fi

    if [[ "$actual_ver" != "$ver" ]]; then
        echo "ERROR: version mismatch for $pkg: wanted $ver, got $actual_ver" >&2
        exit 1
    fi

    if [[ "$actual_arch" != "amd64" && "$actual_arch" != "all" ]]; then
        echo "ERROR: architecture mismatch for $pkg: got $actual_arch" >&2
        exit 1
    fi

    mv "$deb" "$POOL/"
    POOL_INDEX["${actual_pkg}|${actual_ver}|${actual_arch}"]=1

    count=$((count + 1))
done < "$MANIFEST"

"${STORE_ROOT}/modules/linux/ubuntu/scripts/rebuild-apt-repository"

echo
echo "AI Stores: acquired ${count} missing Playwright APT artifacts"
